# Copia este archivo como ".env" y rellena tus valores reales de Supabase.
# Los encuentras en: Supabase → tu proyecto → Settings → API

# URL del proyecto (ej. https://abcdxyz.supabase.co)
SUPABASE_URL=

# Clave "service_role" (SECRETA). Úsala SOLO en el backend, NUNCA en el frontend.
# Está en Settings → API → Project API keys → service_role.
SUPABASE_SERVICE_KEY=

# Puerto local (opcional).
PORT=3000
